# Riffscribe runs its AI fully in the browser — none of these are required to
# transcribe, separate stems, slow down or record. They only enable saving
# projects to an account.

# Supabase (optional — enables sign-in + saved projects)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the ~180MB HTDemucs ONNX model is fetched from. Override to self-host.
NEXT_PUBLIC_DEMUCS_MODEL_URL=https://huggingface.co/timcsy/demucs-web-onnx/resolve/main/htdemucs_embedded.onnx
