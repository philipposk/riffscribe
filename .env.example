# Everything here is optional. With none of it set, the studio works on its own:
# no accounts needed, no server, nothing leaves the browser. Accounts, saved
# songs, the assistant and billing each switch on with the variables below.
# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Variables starting NEXT_PUBLIC_ are published to every visitor and read when
# the site is built, so changing one needs a new deploy. Never put a secret in one.

# --- The site -----------------------------------------------------------------
# The public address of the site, no trailing slash (https://riffscribe.6x7.gr).
# Used for links in emails, Stripe return URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# --- The assistant ------------------------------------------------------------
# Without any of these the assistant widget simply does not appear.
# OpenRouter key: the default route, and the fallback when the Claude key below is missing or fails.
OPENROUTER_API_KEY=
# Anthropic key: used first for Claude models. Server only.
ANTHROPIC_API_KEY=
# The user id (uuid) of the first admin, so the admin page works before the
# riffscribe_admins table has a row. Leave empty once an admin row exists.
RIFFSCRIBE_ADMIN_BOOTSTRAP=

# --- Saving and sharing charts ------------------------------------------------
# Without these the save and share controls do not appear, and /c/<id> says so.
# Create a Supabase project, run supabase/schema.sql, then supabase/assistant_chats.sql,
# then supabase/accounts.sql, then every file in supabase/migrations/ in order, then paste
# the project URL and the anon (publishable) key here.
#
# Only charts are stored (parts, notes, tempo, key, sections, loop) and, for
# signed-in players, the text of their chats with the assistant. Audio is never
# uploaded; stems stay in the browser that made them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Lets the Stripe webhook and the assistant route write usage and
# subscriptions, bypassing row level security. The webhook returns 500 without it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Stripe) ---------------------------------------------------------
# Server only. Use test-mode keys until you are ready to charge real money.
STRIPE_SECRET_KEY=
# The price id of the Pro plan (price_...).
STRIPE_PRICE_PRO=
# The signing secret of the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Build-time flag. Unset: Pro shows "Coming soon" and checkout is off. Set to true to open checkout.
NEXT_PUBLIC_BILLING_ENABLED=
# Each flag below is off unless set to true.
# Stripe Tax: add VAT at checkout and collect tax ids. Turn on only after VAT registration.
STRIPE_TAX_ENABLED=
# Show the "I agree to the terms" box at checkout.
STRIPE_TOS_CONSENT=
# Refund and cancel automatically when Stripe raises an early fraud warning.
STRIPE_AUTO_REFUND_EFW=
# Give new subscribers a button to withdraw within 14 days and get a refund.
STRIPE_SELF_SERVE_WITHDRAWAL=

# --- Analytics ----------------------------------------------------------------
# Without the key PostHog does nothing. The host defaults to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Loading from a link ------------------------------------------------------
# Where the studio looks for the optional fetch helper (npm run fetch-server).
# Defaults to http://127.0.0.1:7749 when empty.
NEXT_PUBLIC_FETCH_URL=

# --- Self-hosting the separation model ----------------------------------------
# Address of the Demucs model file, if you host it yourself. Empty: the built-in default.
NEXT_PUBLIC_DEMUCS_MODEL_URL=

# --- The local fetch helper (npm run fetch-server) ----------------------------
# Port it listens on (default 7749) and the longest clip it will fetch (default 900 seconds).
RIFFSCRIBE_FETCH_PORT=
RIFFSCRIBE_MAX_SECONDS=

# --- The cello eval (npm run eval:cello) --------------------------------------
# Folder holding downloaded evaluation recordings (vocadito/ and musdb7/). Never
# commit these files. Empty: the slow stages that need them skip.
RIFFSCRIBE_EVAL_DATA=
