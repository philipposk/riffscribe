# Everything here is optional. With none of it set, the studio works on its own:
# no accounts needed, no server, nothing leaves the browser. Accounts, saved
# songs, the assistant and billing each switch on with the variables below.

# --- The assistant -----------------------------------------------------------
# Without this the assistant widget simply does not appear.
OPENROUTER_API_KEY=
# Override the model it uses. Defaults to a small, cheap one.
ASSISTANT_MODEL=

# --- Saving and sharing charts ----------------------------------------------
# Without these the save and share controls do not appear, and /c/<id> says so.
# Create a Supabase project, run supabase/schema.sql, then
# supabase/assistant_chats.sql, then supabase/accounts.sql against it (accounts.sql
# adds the usage table, plans and limits, and the account menu's functions), then
# paste the project URL and the anon (publishable) key here.
#
# Only charts are stored — parts, notes, tempo, key, sections, loop — and, for
# signed-in players, the text of their chats with the assistant. Audio is never
# uploaded; stems stay in the browser that made them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Accounts, plans and billing ----------------------------------------------
# Server only. Never prefix these with NEXT_PUBLIC_.
# The service-role key lets the Stripe webhook and the assistant route write usage
# and subscriptions. The webhook returns 500 without it.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# Build-time flag: read when the site is built, not at runtime, so changing it
# needs a new deploy. Leave unset and Pro shows "Coming soon".
NEXT_PUBLIC_BILLING_ENABLED=

# --- Analytics ---------------------------------------------------------------
# Without the key PostHog does nothing. The host defaults to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Loading from a link -----------------------------------------------------
# Where the studio looks for the optional fetch helper (npm run fetch-server).
NEXT_PUBLIC_FETCH_URL=http://127.0.0.1:7749

# --- Self-hosting the separation model ---------------------------------------
NEXT_PUBLIC_DEMUCS_MODEL_URL=

# --- The local fetch helper (npm run fetch-server) ---------------------------
# Port it listens on (default 7749) and the longest clip it will fetch (default 900).
RIFFSCRIBE_FETCH_PORT=
RIFFSCRIBE_MAX_SECONDS=
