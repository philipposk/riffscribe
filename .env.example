# Everything here is optional. With none of it set, Riffscribe works exactly as
# it always has: no accounts, no server, nothing leaves the browser.

# --- The assistant -----------------------------------------------------------
# Without this the assistant widget simply does not appear.
OPENROUTER_API_KEY=
# Override the model it uses. Defaults to a small, cheap one.
ASSISTANT_MODEL=

# --- Saving and sharing charts ----------------------------------------------
# Without these the save and share controls do not appear, and /c/<id> says so.
# Create a Supabase project, run supabase/schema.sql against it, then paste the
# project URL and the anon (publishable) key here.
#
# Only charts are stored — parts, notes, tempo, key, sections, loop. Audio is
# never uploaded; stems stay in the browser that made them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Loading from a link -----------------------------------------------------
# Where the studio looks for the optional fetch helper (npm run fetch-server).
NEXT_PUBLIC_FETCH_URL=http://127.0.0.1:7749

# --- Self-hosting the separation model ---------------------------------------
NEXT_PUBLIC_DEMUCS_MODEL_URL=
