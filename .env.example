# Riffscribe's audio work all happens in the browser — none of these are needed
# to transcribe, separate stems, slow down or record.

# Where the ~180MB HTDemucs ONNX model is fetched from. Override to self-host.
NEXT_PUBLIC_DEMUCS_MODEL_URL=https://huggingface.co/timcsy/demucs-web-onnx/resolve/main/htdemucs_embedded.onnx

# Page assistant. Without this the assistant is simply absent; the studio works
# fine without it. The route is unauthenticated, so it is spend-limited: a small
# model, a hard token ceiling and a per-IP request budget.
OPENROUTER_API_KEY=
ASSISTANT_MODEL=openai/gpt-oss-20b
