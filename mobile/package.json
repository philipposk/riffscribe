{
  "name": "riffscribe-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor iOS/Android shell for Riffscribe. Loads the live site; the Next server is not bundled.",
  "scripts": {
    "sync": "cap sync",
    "ios": "cap run ios",
    "android": "cap run android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "add:ios": "cap add ios --packagemanager SPM",
    "add:android": "cap add android",
    "native-config": "node scripts/apply-native-config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
